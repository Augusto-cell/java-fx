<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      prefHeight="450.0"
      prefWidth="700.0"
      spacing="0.0"
      style="-fx-background-color: #0f172a;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.senai.javafx.javafx.HelloController">

    <VBox alignment="CENTER"
          maxWidth="400.0"
          spacing="18.0"
          style="-fx-background-color: #1e293b;
                 -fx-background-radius: 20;
                 -fx-padding: 40;">

        <Label text="Bem-vindo!"
               style="-fx-text-fill: white;
                      -fx-font-size: 28px;
                      -fx-font-weight: bold;" />

        <Label text="Cadastre seu nome para continuar"
               style="-fx-text-fill: #94a3b8;
                      -fx-font-size: 14px;" />

        <TextField fx:id="digiteAqui"
                   promptText="Digite seu nome"
                   prefHeight="45.0"
                   maxWidth="320.0"
                   style="-fx-background-color: #334155;
                          -fx-text-fill: white;
                          -fx-prompt-text-fill: #94a3b8;
                          -fx-background-radius: 10;
                          -fx-border-radius: 10;
                          -fx-border-color: #475569;
                          -fx-padding: 0 15 0 15;
                          -fx-font-size: 14px;" />

        <Button mnemonicParsing="false"
                onAction="#cadastrarPessoa"
                text="Cadastrar"
                prefHeight="45.0"
                maxWidth="320.0"
                style="-fx-background-color: #3b82f6;
                       -fx-text-fill: white;
                       -fx-background-radius: 10;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;" />

        <Label fx:id="nomePessoa"
               text="olá bb"
               style="-fx-text-fill: #e2e8f0;
                      -fx-font-size: 16px;" />

        <Label fx:id="welcomeText"
               style="-fx-text-fill: #60a5fa;
                      -fx-font-size: 14px;" />

    </VBox>

</VBox>